# ==============================================================================
# RR ScoutIQ — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (`cp .env.example .env`)
# 2. Update variables according to your local environment
# 3. DO NOT commit your local .env file or any credentials to Git
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_PORT=8501
APP_HOST=localhost
LOG_LEVEL=INFO

# Storage & Embedded Database (Relative to project root)
DUCKDB_PATH=data/scout_iq.duckdb

# Optional External Integrations (Safe placeholders only - do not paste secrets here)
EXTERNAL_CRICKET_API_KEY=your_cricket_api_key_here
ANALYTICS_SERVICE_TOKEN=your_service_token_here
